# Public site URL (production: https://devladder.vercel.app)
NEXT_PUBLIC_SITE_URL=https://devladder.vercel.app

# Required for online accounts (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Also accepted by the app (legacy Supabase anon key name)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-side only — in-app tutor (devyyyyy / ChatGPT Luna). Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Default: gpt-6-luna (ChatGPT Luna). Override if your key uses another snapshot.
OPENAI_MODEL=gpt-6-luna
# Expert tutor mode: none | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=high
